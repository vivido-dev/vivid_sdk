+pub(crate) fn resource_quota_exceeded(
+    client: &wayland_server::Client,
+    display: &wayland_server::DisplayHandle,
+    message: &'static str,
+) {
+    // wl_display is backend-owned rather than a generated server resource.
+    // kill_client alone does not send the supplied error on the Rust backend.
+    let backend = display.backend_handle();
+    let mut core = None;
+    let _ = backend.with_all_objects_for(client.id(), |object| {
+        if object.protocol_id() == 1 {
+            core = Some(object);
+        }
+    });
+    if let Some(core) = core {
+        backend.post_error(
+            core,
+            2, // wl_display.error.no_memory
+            std::ffi::CString::new(message).expect("static error has no NUL"),
+        );
+    } else {
+        // The system backend does not enumerate backend-owned resources.
+        client.kill(
+            display,
+            wayland_server::backend::protocol::ProtocolError {
+                code: 2,
+                object_id: 1,
+                object_interface: "wl_display".into(),
+                message: message.into(),
+            },
+        );
+    }
+}
