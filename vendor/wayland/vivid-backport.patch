+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    #[derive(Default)]
+    struct Status(Mutex<Option<u32>>);
+    impl ClientData for Status {
+        fn disconnected(&self, _: ClientId, reason: DisconnectReason) {
+            if let DisconnectReason::ProtocolError(error) = reason {
+                *self.0.lock().unwrap() = Some(error.code);
+            }
+        }
+    }
+
+    #[test]
+    fn exhausted_object_generations_revoke_the_client_without_wrapping() {
+        let (socket, _peer) = UnixStream::pair().unwrap();
+        let status = Arc::new(Status::default());
+        let mut client = Client::<()>::new(
+            socket,
+            InnerClientId { id: 0, serial: 1 },
+            false,
+            status.clone(),
+            4096,
+        );
+        client.last_serial = u32::MAX;
+        assert!(client.next_serial().is_none());
+        assert!(client.killed);
+        assert_eq!(client.last_serial, u32::MAX);
+        assert_eq!(*status.0.lock().unwrap(), Some(DisplayError::NoMemory as u32));
+    }
+
+    #[test]
+    fn exhausted_connection_generations_preserve_the_last_admitted_owner() {
+        let mut clients = ClientStore::<()>::new(false);
+        clients.last_serial = u32::MAX - 1;
+        let (socket, _peer) = UnixStream::pair().unwrap();
+        let owner = clients.create_client(socket, Arc::new(()), 4096).unwrap();
+        assert_eq!(owner.serial, u32::MAX);
+        let (other, _other_peer) = UnixStream::pair().unwrap();
+        assert!(clients.create_client(other, Arc::new(()), 4096).is_err());
+        assert_eq!(clients.last_serial, u32::MAX);
+        assert_eq!(clients.clients.len(), 1);
+        assert!(!clients.get_client(owner).unwrap().killed);
+    }
+}
