+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::protocol::ANONYMOUS_INTERFACE;
+
+    fn object() -> Object<()> {
+        Object { interface: &ANONYMOUS_INTERFACE, version: 1, data: () }
+    }
+
+    #[test]
+    fn limits_charge_both_namespaces_and_retired_slots_but_allow_reuse() {
+        let mut map = ObjectMap::new();
+        map.set_max_slots(NonZeroUsize::new(4));
+        map.insert_at(1, object()).unwrap();
+        let server = map.server_insert_new(object()).unwrap();
+        map.insert_at(2, object()).unwrap();
+        map.remove(2);
+        map.insert_at(2, object()).unwrap();
+        map.insert_at(3, object()).unwrap();
+        map.remove(2);
+        assert_eq!(map.insert_at(4, object()), Err(InsertError::Limit));
+        assert_eq!(map.server_insert_new(object()), Err(InsertError::Limit));
+        assert_eq!(map.insert_at(1000, object()), Err(InsertError::InvalidId));
+        assert_eq!(map.client_objects.len() + map.server_objects.len(), 4);
+        map.remove(server);
+        assert_eq!(map.server_insert_new(object()).unwrap(), server);
+        map.insert_at(2, object()).unwrap();
+        assert_eq!(map.all_objects().count(), 4);
+    }
+}
