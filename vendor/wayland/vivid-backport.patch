+        recvmsg(&peer, &mut [IoSliceMut::new(&mut bytes)], &mut ancillary, RecvFlags::DONTWAIT)
+            .unwrap()
+            .bytes,
+        8
+    );
+    let fds = ancillary
+        .drain()
+        .filter_map(|item| match item {
+            RecvAncillaryMessage::ScmRights(fds) => Some(fds),
+            _ => None,
+        })
+        .flatten()
+        .collect::<Vec<_>>();
+    assert_eq!(fds.len(), 1);
